# ==========================================
# Mayukhaditya Environment Configuration
# ==========================================

# Microsoft 365 / Azure AD Graph API Credentials
# Used by /api/contact for enterprise email delivery
MS_TENANT_ID=your_azure_tenant_id
MS_CLIENT_ID=your_azure_client_id
MS_CLIENT_SECRET=your_azure_client_secret
MAIL_SENDER=sender@mayukhaditya.com
HOST_EMAIL=info@mayukhaditya.com

# Cloudflare Turnstile CAPTCHA (Spam protection)
# For local testing, use Cloudflare's dummy test keys:
# Site Key: 1x00000000000000000000AA
# Secret Key: 1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key

# Upstash Redis (Serverless rate limiting for /api/contact)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-rest-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
